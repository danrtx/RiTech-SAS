# Copia este archivo como .env y ajusta si algún puerto está ocupado.
# Credenciales SOLO para desarrollo local. Nunca usar en producción.

# Docker Compose: PostgreSQL
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=ritech_dev
POSTGRES_PORT=5433

# Docker Compose: Redis
REDIS_PASSWORD=ritech_dev
REDIS_PORT=6379

# Backend NestJS: conexión a los servicios
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ritech
DB_USER=ritech
DB_PASSWORD=ritech_dev
DATABASE_URL=postgresql://ritech:ritech_dev@localhost:5433/ritech

REDIS_HOST=localhost
# TLS obligatorio cuando NODE_ENV=production. Local Docker no proporciona TLS.
DB_TLS_ENABLED=false
REDIS_TLS_ENABLED=false
# Opcional: CA privada PEM fuera del repositorio; vacío usa las CA de Node.
DB_TLS_CA_FILE=
REDIS_TLS_CA_FILE=
REDIS_URL=redis://:ritech_dev@localhost:6379/0

# Fuente principal: Twelve Data, QQQ. Activar con una clave local propia.
MARKET_DATA_ENABLED=false
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_FEED=realtime
MARKET_DATA_SYMBOL=QQQ
MARKET_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
TWELVE_DATA_API_KEY=
# Opcional: paper activa aceptación simulada y aviso visible en Flutter; no opera dinero.
EXECUTION_MODE=disabled
MARKET_DATA_HEARTBEAT_MS=10000
MARKET_DATA_HEARTBEAT_TIMEOUT_MS=10000
# Detección de transporte independiente del heartbeat JSON del proveedor.
MARKET_DATA_TRANSPORT_PING_MS=500
MARKET_DATA_TRANSPORT_PONG_TIMEOUT_MS=500
# Conservar el timestamp original: no elevar este límite para ocultar datos viejos.
MARKET_DATA_MAX_TICK_AGE_MS=2000

# Alpaca es opcional y solo se usa seleccionándolo expresamente.
# No hay fallback automático. Para activarlo, cambiar provider=alpaca,
# feed=iex y quitar MARKET_DATA_WS_URL para usar el endpoint de ese proveedor.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# Notificaciones push de emergencia (FCM). Deshabilitado por defecto.
# Cuenta de servicio con el rol "Firebase Cloud Messaging API Admin" únicamente;
# el JSON vive fuera del repositorio. Un proyecto Firebase por ambiente.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=
# Por defecto hedging-alerts-<development|test|production>.
# FCM_TOPIC=
# FCM_SEND_TIMEOUT_MS=5000
# FCM_QUEUE_CAPACITY=256

# Sprint 3: IOC reales en sandbox IBKR mediante Client Portal Gateway local.
# EXECUTION_MODE=ibkr-paper habilita el servicio y el comando broker:ioc.
# Iniciar sesión PAPER y MFA en el Gateway; no guardar usuario/contraseña aquí.
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_PAPER_ACCOUNT=
# Confiar en la CA/certificado local del Gateway con NODE_EXTRA_CA_CERTS.
# Nunca usar NODE_TLS_REJECT_UNAUTHORIZED=0.
# HTTPS del backend (HTTP y Socket.IO). Obligatorio con NODE_ENV=production.
# Certificado y clave PEM externos al repositorio. El cliente debe confiar en su CA.
SERVER_TLS_ENABLED=false
SERVER_TLS_CERT_FILE=
SERVER_TLS_KEY_FILE=

# Sprint 4: agente general Gemini. Reutiliza el feed MARKET_DATA_* configurado.
# Twelve Data aporta mercado, no cuentas ni posiciones. No hay roles ni alta de usuarios.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=15000
INVESTMENT_GENERAL_CALLS_HOUR=10
INVESTMENT_SERVICE_CALLS_HOUR=100
INVESTMENT_QUOTE_MAX_AGE_MS=30000
INVESTMENT_ATR_MAX_AGE_MS=180000
INVESTMENT_CONTEXT_MAX_AGE_MS=300000
INVESTMENT_VALIDITY_MS=30000
INVESTMENT_RETENTION_DAYS=90
