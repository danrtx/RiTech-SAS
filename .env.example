# Copia este archivo como .env y ajusta si algún puerto está ocupado.
# Credenciales SOLO para desarrollo local. Nunca usar en producción.

# Docker Compose: PostgreSQL
POSTGRES_DB=ritech
POSTGRES_USER=ritech
POSTGRES_PASSWORD=ritech_dev
POSTGRES_PORT=5433

# Docker Compose: Redis
REDIS_PASSWORD=ritech_dev
REDIS_PORT=6379

# Backend NestJS: conexión a los servicios
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ritech
DB_USER=ritech
DB_PASSWORD=ritech_dev
DATABASE_URL=postgresql://ritech:ritech_dev@localhost:5433/ritech

REDIS_HOST=localhost
REDIS_URL=redis://:ritech_dev@localhost:6379/0

# Motor ATR backend y ventana de ticks (UTC)
ATR_SYMBOLS=NDX,QQQ,AAPL,NVDA
ATR_PERIOD=14
ATR_THRESHOLD=1.5
ATR_BASELINE_WINDOW=20
ATR_MAX_GAP_MINUTES=5
ATR_COOLDOWN_MINUTES=0
ATR_EPSILON=1e-12
ATR_READ_TIMEOUT_MS=5000
TICK_RETENTION_MINUTES=1440
TICK_MAX_PER_SYMBOL=100000
TICK_KEY_PREFIX=ritech:market:v1

# Solo desarrollo: activar explicitamente el proveedor sintetico local
# MOCK_FEED_URL=ws://127.0.0.1:4100
